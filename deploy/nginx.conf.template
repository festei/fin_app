# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template).
#   API_TOKEN   bearer token added to every /api request; the browser never sees it
#   AUTH_BASIC  basic-auth realm, or "off" (dev compose). The user file is mounted at
#               /etc/nginx/htpasswd (prod compose requires it; without it nginx answers 500, so
#               a missing file fails closed).
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;

  auth_basic "${AUTH_BASIC}";
  auth_basic_user_file /etc/nginx/htpasswd;

  # API + WebSocket go to the api service; everything else is the SPA.
  location /api/ {
    proxy_pass http://api:8000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    # Replaces the client's Authorization header (the basic-auth credentials stay here):
    # the API's write endpoints are authorised by this server-side token.
    proxy_set_header Authorization "Bearer ${API_TOKEN}";
    proxy_read_timeout 3600s;
  }
  location = /healthz {
    auth_basic off;  # container health checks carry no credentials
    proxy_pass http://api:8000/healthz;
  }
  location / { try_files $uri /index.html; }
}
