# Copy to .env (never commit .env). All config is via env vars.
POSTGRES_USER=fin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fin
FINANCE_API=            # Alpha Vantage key (fallback fundamentals provider)

# Feature flags (override config/features.yml)
FEATURE_TELEGRAM_ENABLED=false
# Required only when FEATURE_TELEGRAM_ENABLED=true:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Image tag used by docker-compose.prod.yml
TAG=dev
