# Copy to .env (never commit .env). All config is via env vars.
POSTGRES_USER=fin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fin
FINANCE_API=            # Alpha Vantage key (fallback fundamentals provider)
SEC_USER_AGENT=         # required by the SEC for EDGAR: "Your Name you@example.com"
FRED_API_KEY=           # free key from fred.stlouisfed.org (bond yields and spreads)
# Optional: a full SQLAlchemy URL; otherwise built from POSTGRES_* (+ POSTGRES_HOST/PORT).
# The database must be UTF-8. In compose set POSTGRES_HOST=db.
DATABASE_URL=

# Bearer token required by the state-changing API endpoints (watchlist, mark-as-read).
# Unset = those endpoints are disabled (503). Prod compose requires it; dev defaults to dev-token.
# The web container's nginx adds it to /api requests, so the browser never holds it. In `pnpm dev`
# the Vite proxy does the same (reads API_TOKEN, default dev-token).
API_TOKEN=
# Prod compose only: path of the htpasswd file for the web UI's basic auth
HTPASSWD_FILE=

# Feature flags (override config/features.yml)
FEATURE_TELEGRAM_ENABLED=false
# Required only when FEATURE_TELEGRAM_ENABLED=true (startup fails loudly if one is missing).
# The chat id restricts the bot: it answers no other chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Image tag used by docker-compose.prod.yml
TAG=dev
